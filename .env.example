# --- App ---
DEMO_MODE=true
ENVIRONMENT=development
TIMEZONE=Asia/Kolkata
# Current portfolio engine is the default. Enable the older recommendation flow explicitly.
LEGACY_PIPELINE_ENABLED=false
# After-close data jobs; false is useful for a controlled manual-data rehearsal.
SCHEDULER_ENABLED=true

# --- Database ---
# Docker Compose requires this; use a non-default value. (Changing it does not
# alter an existing postgres_data volume -- see SETUP.md.)
POSTGRES_PASSWORD=change-me
# Keep the password in the two URLs below in sync with POSTGRES_PASSWORD.
DATABASE_URL=postgresql+asyncpg://postgres:change-me@localhost:5432/equity_research
SYNC_DATABASE_URL=postgresql+psycopg2://postgres:change-me@localhost:5432/equity_research

# --- Market data: Yahoo Finance, no account/key needed ---

# --- Qwen (LLM council/planner) ---
# Any OpenAI-compatible endpoint: DashScope, OpenRouter, or a self-hosted vLLM server.
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_API_KEY=
QWEN_MODEL=qwen2.5-32b-instruct

# --- Gemini (V3 research-pipeline model adapter, app/models_iface/model_adapter.py) ---
# Optional -- research pipeline runs evidence-only (no synthesis) without a key.
# gemini_configured (app/core/config.py) is False when this is blank.
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_API_KEY=
GEMINI_FLASH_LITE_MODEL=gemini-3.5-flash-lite
GEMINI_FLASH_MODEL=gemini-3.8-flash

# --- Model cache (Kronos / FinBERT weights) ---
HF_HOME=./data/cache/huggingface
KRONOS_MODEL_ID=NeoQuasar/Kronos-small
KRONOS_TOKENIZER_ID=NeoQuasar/Kronos-Tokenizer-base
FINBERT_MODEL_ID=ProsusAI/finbert

# --- Private mode ---
# Allow browser origins on *.github.dev (Codespaces). Keep false when the app
# holds real broker/holdings data.
ALLOW_FORWARDED_ORIGINS=false

# --- Angel One SmartAPI (read-only holdings import) ---
# ANGEL_API_KEY: from your SmartAPI app. ANGEL_FINGERPRINT_KEY: generate once with
# `openssl rand -hex 32` and BACK IT UP -- changing it makes the same broker
# account look new. Your client code / PIN / TOTP are never put here; they are
# typed into the setup CLI (see SETUP.md). Session tokens go to
# ~/.local/state/pie (0600), or ANGEL_SESSION_DIR if set.
ANGEL_API_KEY=
ANGEL_FINGERPRINT_KEY=
ANGEL_SESSION_DIR=
# Public IP registered on your SmartAPI app (sent as X-ClientPublicIP). Default 127.0.0.1;
# set this if login is rejected for IP reasons.
ANGEL_CLIENT_PUBLIC_IP=
# Route all Angel traffic through your VPS (SSH -D tunnel), e.g. socks5://127.0.0.1:1080.
# Set ANGEL_CLIENT_PUBLIC_IP to the VPS IP you whitelisted. Leave both empty for direct access.
ANGEL_PROXY_URL=

# --- Worker ---
WORKER_POLL_INTERVAL_SECONDS=5

# --- TrueData (one-time historical cache script only, scripts/sync_truedata_history.py) ---
# Trial/paid credentials -- never commit real values here. See .TD_API_Docs/
# (gitignored) for the API docs. Not used by the live pipeline.
TRUEDATA_USERNAME=
TRUEDATA_PASSWORD=
