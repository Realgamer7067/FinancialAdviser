# --- App ---
DEMO_MODE=true
ENVIRONMENT=development
SECRET_KEY=change-me-in-production
TIMEZONE=Asia/Kolkata

# --- Database ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/equity_research
SYNC_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/equity_research

# --- Market data: Yahoo Finance, no account/key needed ---

# --- Qwen (LLM council/planner) ---
# Any OpenAI-compatible endpoint: DashScope, OpenRouter, or a self-hosted vLLM server.
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_API_KEY=
QWEN_MODEL=qwen2.5-32b-instruct

# --- Model cache (Kronos / FinBERT weights) ---
HF_HOME=./data/cache/huggingface
KRONOS_MODEL_ID=NeoQuasar/Kronos-small
KRONOS_TOKENIZER_ID=NeoQuasar/Kronos-Tokenizer-base
FINBERT_MODEL_ID=ProsusAI/finbert

# --- Worker ---
WORKER_POLL_INTERVAL_SECONDS=5
